# Gordonridge Community Development Initiative - Environment Configuration
# Copy this file to .env.local and populate the credentials to enable real Gmail SMTP delivery.

# Gmail account address used for sending outbound notifications
GMAIL_USER=

# 16-character Google App Password (generated in Google Account -> Security -> App passwords)
GMAIL_APP_PASSWORD=

# Organization email inbox where community inquiries should be delivered
# If left blank, inquiries will default to GMAIL_USER
GORDONRIDGE_RECIPIENT_EMAIL=
